# Copiar este archivo como .env y completar los valores

APP_NAME=
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./nombre.db

# credenciales xtream codes
XTREAM_HOST=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# user-agent xtream codes
XTREAM_USER_AGENT=

# configuración de red
REQUEST_TIMEOUT=5

# firma token
JWT_SECRET=
JWT_EXPIRE_MINUTES=60